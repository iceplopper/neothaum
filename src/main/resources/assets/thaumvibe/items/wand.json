{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:special",
          "base": "thaumvibe:item/wand/base",
          "model": {
            "type": "thaumvibe:wand",
            "view": "inventory"
          }
        }
      },
      {
        "when": [
          "thirdperson_righthand",
          "thirdperson_lefthand"
        ],
        "model": {
          "type": "minecraft:special",
          "base": "thaumvibe:item/wand/base",
          "model": {
            "type": "thaumvibe:wand",
            "view": "equipped"
          }
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:special",
          "base": "thaumvibe:item/wand/base",
          "model": {
            "type": "thaumvibe:wand",
            "view": "first_person"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "thaumvibe:item/wand/base",
      "model": {
        "type": "thaumvibe:wand",
        "view": "entity"
      }
    }
  }
}