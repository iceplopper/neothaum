{
	"schemaVersion": 1,
	"id": "neothaum",
	"version": "${version}",
	"name": "NeoThaum",
	"description": "A modern Fabric recreation of Thaumcraft 4",
	"authors": [
		"Ice Plopper"
	],
	"contact": {
		"homepage": "https://github.com/iceplopper/neothaum",
		"issues": "https://github.com/iceplopper/neothaum/issues",
		"sources": "https://github.com/iceplopper/neothaum"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/neothaum/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.neothaum.NeoThaum"
		],
		"client": [
			"dev.neothaum.client.NeoThaumClient"
		],
		"rei_client": [
			"dev.neothaum.client.rei.NeoThaumReiPlugin"
		],
		"jei_mod_plugin": [
			"dev.neothaum.client.jei.NeoThaumJeiPlugin"
		],
		"jade": [
			"dev.neothaum.client.addon.jade.NeoThaumJadePlugin"
		],
		"modmenu": [
			"dev.neothaum.client.addon.modmenu.NeoThaumModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"jei": "*",
		"roughlyenoughitems": "*",
		"appleskin": "*",
		"sodium": "*",
		"iris": "*",
		"lambdynlights": "*",
		"jade": "*",
		"modmenu": "*",
		"trinkets_updated": "*"
	},
	"mixins": [
		"neothaum.mixins.json",
		{
			"config": "neothaum.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "neothaum.xaero.mixins.json",
			"environment": "client"
		}
	]
}
